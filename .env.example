# Server-side only. Never prefix these keys with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
# Hosted deployments: use a team-scoped treg token; local development can use `treg login` instead.
TREG_TOKEN=
# Only required for a personal token (team-scoped tokens already carry the team).
TREG_ORG=
